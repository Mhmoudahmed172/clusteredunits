# GEMINI_API_KEY: Required for Gemini AI API calls (if used).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PORT: Server port (defaults to 3000)
PORT="3000"

# DATABASE_PATH: Path to persistent SQLite database file
DATABASE_PATH="./data/gaza_clusters.db"

# Initial Admin Credentials (seeded idempotently on first run if no admin exists)
INITIAL_ADMIN_EMAIL="admin@pfi-gaza.ps"
INITIAL_ADMIN_PASSWORD="Admin@2025"
INITIAL_ADMIN_NAME="مدير النظام - الاتحاد العام للصناعات"

# Initial Editor Credentials (seeded idempotently on first run if no editor exists)
INITIAL_EDITOR_EMAIL="editor@pfi-gaza.ps"
INITIAL_EDITOR_PASSWORD="Editor@2025"
INITIAL_EDITOR_NAME="محرّر المنصة ومتابع الطلبات"

# Initial Exchange Rate (ILS per 1 USD)
INITIAL_EXCHANGE_RATE="3.1"
